@page "{id:int}"
@model wt_lab8_8razor_postgresql_krivetskij.Pages.Patients.DeleteModel

@{
    ViewData["Title"] = "Удаление пациента";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-danger shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h1 class="h3 fw-bold text-danger">
                        Удаление пациента
                    </h1>

                    @if (Model.Patient != null)
                    {
                        <p class="mt-3">
                            Вы действительно хотите удалить пациента
                            <strong>@Model.Patient.FullName</strong>?
                        </p>

                        <p class="text-muted">
                            Это действие нельзя отменить.
                        </p>

                        <form method="post">
                            <input type="hidden" asp-for="Patient.Id" />

                            <button type="submit"
                                    class="btn btn-danger">
                                Да, удалить
                            </button>

                            <a asp-page="Details"
                               asp-route-id="@Model.Patient.Id"
                               class="btn btn-outline-secondary">
                                Отмена
                            </a>
                        </form>
                    }
                    else
                    {
                        <p>Пациент не найден.</p>

                        <a asp-page="Index"
                           class="btn btn-outline-secondary">
                            К списку пациентов
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
