@page "{id:int}"
@model wt_lab8_8razor_postgresql_krivetskij.Pages.Doctors.DetailsModel

@{
    ViewData["Title"] = "Карточка врача";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Карточка врача</h1>
            <p class="text-muted mb-0">Наш специалист — наша опора</p>
        </div>

        @if (Model.Doctor!.IsActive)
        {
            <span class="badge bg-success fs-6">Принимает пациентов</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">Неактивен</span>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3">
            <h4 class="mb-0">@Model.Doctor.FullName</h4>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <small class="text-muted">Номер врача</small>
                    <h5>@Model.Doctor.Id</h5>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Специальность</small>
                    <h5>
                        <span class="badge bg-info text-dark">
                            @Model.Doctor.Specialty
                        </span>
                    </h5>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Опыт работы</small>
                    <h5>@Model.Doctor.ExperienceYears лет</h5>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Кабинет</small>
                    <h5>№ @Model.Doctor.Office</h5>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-3">
            <a asp-page="Edit" asp-route-id="@Model.Doctor.Id"
               class="btn btn-warning">
                Изменить данные
            </a>

            <a asp-page="Index" class="btn btn-outline-secondary">
                К списку врачей
            </a>
        </div>
    </div>
</div>
