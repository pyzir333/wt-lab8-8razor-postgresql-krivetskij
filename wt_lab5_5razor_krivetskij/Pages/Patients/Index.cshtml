@page
@model wt_lab5_5razor_krivetskij.Pages.Patients.IndexModel

@{
    ViewData["Title"] = "Список пациентов";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Пациенты</h1>
            <p class="text-muted mb-0">
                Управление пациентами медицинского центра
            </p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            + Добавить пациента
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">

                <div class="table-responsive shadow-sm rounded-3">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>№</th>
                                <th>ФИО пациента</th>
                                <th>Возраст</th>
                                <th>Врач</th>
                                <th>Дата приёма</th>
                                <th>Диагноз</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model.Patients)
                            {
                                var doctor = Model.Doctors
                                .FirstOrDefault(d => d.Id == patient.DoctorId);

                                <tr>
                                    <td>@patient.Id</td>
                                    <td class="fw-semibold">@patient.FullName</td>
                                    <td>@patient.Age</td>
                                    <td>
                                        @if (doctor != null)
                                        {
                                            <span>@doctor.FullName</span>
                                            <br />
                                            <small class="text-muted">@doctor.Specialty</small>
                                        }
                                        else
                                        {
                                            <span>@patient.DoctorSpecialty</span>
                                        }
                                    </td>
                                    <td>@patient.AppointmentDate.ToString("dd.MM.yyyy")</td>
                                    <td>@patient.Diagnosis</td>
                                    <td>
                                        @if (patient.IsActive)
                                        {
                                            <span class="badge bg-success">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Неактивен</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-page="Details"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Подробнее
                                            </a>

                                            <a asp-page="Edit"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Изменить
                                            </a>

                                            <a asp-page="Delete"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Удалить
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            <p class="text-muted mb-0">
                Всего пациентов: <strong>@Model.Patients.Count</strong>
            </p>
        </div>
    </div>

    <a asp-page="/Index" class="btn btn-outline-secondary mt-3">
        ← На главную
    </a>
</div>
