@page "{id:int}"
@model wt_lab5_5razor_krivetskij.Pages.Doctors.EditModel

@{
    ViewData["Title"] = "Редактирование врача";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-4">Редактирование врача</h1>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="Doctor.Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Doctor.FullName"
                                   class="form-label">ФИО врача</label>
                            <input asp-for="Doctor.FullName"
                                   class="form-control" />
                            <span asp-validation-for="Doctor.FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor.Specialty"
                                   class="form-label">Специальность</label>
                            <select asp-for="Doctor.Specialty"
                                    class="form-select">
                                <option value="">Выберите специальность</option>
                                <option value="Терапевт">Терапевт</option>
                                <option value="Кардиолог">Кардиолог</option>
                                <option value="Невролог">Невролог</option>
                                <option value="Офтальмолог">Офтальмолог</option>
                                <option value="Хирург">Хирург</option>
                            </select>
                            <span asp-validation-for="Doctor.Specialty"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor.ExperienceYears"
                                   class="form-label">Стаж работы (лет)</label>
                            <input asp-for="Doctor.ExperienceYears"
                                   type="number"
                                   min="0" max="60"
                                   class="form-control" />
                            <span asp-validation-for="Doctor.ExperienceYears"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor.Office"
                                   class="form-label">Кабинет</label>
                            <input asp-for="Doctor.Office"
                                   class="form-control" />
                            <span asp-validation-for="Doctor.Office"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Doctor.IsActive"
                                   class="form-check-input" />
                            <label asp-for="Doctor.IsActive"
                                   class="form-check-label">
                                Врач работает в центре
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Сохранить изменения
                        </button>

                        <a asp-page="Index"
                           class="btn btn-outline-secondary">Отмена</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
