@page
@model wt_lab5_5razor_krivetskij.Pages.Doctors.IndexModel

@{
    ViewData["Title"] = "Список врачей";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Врачи</h1>
            <p class="text-muted mb-0">
                Управление специалистами медицинского центра
            </p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            + Добавить врача
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">

                <div class="table-responsive shadow-sm rounded-3">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>№</th>
                                <th>ФИО врача</th>
                                <th>Специальность</th>
                                <th>Стаж</th>
                                <th>Кабинет</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in Model.Doctors)
                            {
                                <tr>
                                    <td>@doctor.Id</td>
                                    <td class="fw-semibold">@doctor.FullName</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @doctor.Specialty
                                        </span>
                                    </td>
                                    <td>@doctor.ExperienceYears лет</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            Каб. @doctor.Office
                                        </span>
                                    </td>
                                    <td>
                                        @if (doctor.IsActive)
                                        {
                                            <span class="badge bg-success">Принимает</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Неактивен</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-page="Details"
                                               asp-route-id="@doctor.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Подробнее
                                            </a>

                                            <a asp-page="Edit"
                                               asp-route-id="@doctor.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Изменить
                                            </a>

                                            <a asp-page="Delete"
                                               asp-route-id="@doctor.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Удалить
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            <p class="text-muted mb-0">
                Всего врачей: <strong>@Model.Doctors.Count</strong>
            </p>
        </div>
    </div>

    <a asp-page="/Index" class="btn btn-outline-secondary mt-3">
        ← На главную
    </a>
</div>
